Error: {"agentfiles":[{"id":"01a1d0a0e2d7707a9aa6824997d523ca","owner":"user:01a1d0a0e2c476b7b6f7c48e18a972c3","name":"claude","version":1,"created_at":1794501567,"updated_at":1794501567}],"reaches_all":false,"builtin":[{"name":"harness-goose","harness":"goose","text":"# Goose (aaif-goose/goose) as a harness in a Shards microVM: the Agentfile kiln ships for it (plan\n# 01a1cd8e862e7169a074db3d5fa33f3d, step 23; research 01a1ce705e3d72af8563e07fa92a7460, f1-f28).\n# Its build context is what `kiln agentfiles context goose DIR` writes: this file, and for each\n# platform goose-<arch>/ with harness.json and pin.json's goose, checked and unpacked to bin/goose.\n# It holds no credential: a person's provider keys stay on their own volume (below).\n\n# The default base: Debian with git, an ssh client, curl and CA certificates on both arches, the\n# digest pin.sh read (pin.json's base). Any base works, as Goose's build is static (f10), but Goose\n# checks TLS against the base's CA bundle, so a base without one can't reach a provider (f18).\nARG BASE=buildpack-deps:trixie-scm@sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10\nFROM ${BASE}\n\n# Goose's own static build for the platform being built: no RUN, and no libc variant (f10, f23).\nARG TARGETARCH\nHARNESS goose FROM ./goose-${TARGETARCH}\n\n# Its providers over HTTPS, as the bring-up proved them (f21): a network for Goose alone, names\n# resolved by the microVM (--dns), and TCP 443 out at the network's boundary and the microVM's;\n# nothing in, and no other port or protocol out. Step 9's grants by name replace these three lines.\nNETWORK --dns --egress=443/tcp provider FOR goose\nEXPOSE --harnesses=goose 443/tcp AS egress FOR provider\nCONNECT goose WITH goose ON provider\n\n# Two volumes of Goose's alone (D109): the project, and the person's Goose root, GOOSE_PATH_ROOT in\n# harness.json, which holds its config, sessions, logs and the keys its owner saved, and which kiln\n# keeps per person and reads on the host (f14, f15, f5).\nVOLUME --target-kind=harness /workspace FOR goose\nVOLUME --target-kind=harness /home/goose/.local/share/goose FOR goose\n"},{"name":"harness-claude","harness":"claude","text":"# Anthropic's Claude Code as a harness kiln ships (kiln plan 01a1cd8e862e7169a074db3d5fa33f3d, step 19;\n# plan 01a1cf48e8157494ac9a51f7a564f526, research 01a1cf48e8157494b048e1fb2c437f08). Its build installs\n# the binary pin.json pins: kiln writes it at ./claude-<arch>-<libc>/bin/claude, its SHA-256 checked as it\n# downloads, since an http(s) HARNESS source carries no checksum (f26). No RUN fetches it, and no\n# credential is in the image (f48): a person's own sign-in lives in their HOME volume.\n#\n# The base: buildpack-deps:trixie-scm by digest, a Docker Official Image for both arches with git, an ssh\n# client, curl and CA certificates (f46). Another base works: Anthropic's glibc builds need nothing newer\n# than GLIBC_2.17 (f13), and a musl base builds with CLAUDE_LIBC=musl.\nARG BASE=buildpack-deps:trixie-scm@sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10\nARG CLAUDE_LIBC=gnu\n\nFROM ${BASE} AS base-gnu\n\n# Anthropic's musl builds take libgcc, libstdc++ and ripgrep from the system (code.claude.com/docs/en/setup,\n# \"Alpine Linux and musl-based distributions\"; f14).\nFROM ${BASE} AS base-musl\nRUN apk add --no-cache libgcc libstdc++ ripgrep\n\n# BuildKit builds only the stage the variant names (f28).\nFROM base-${CLAUDE_LIBC}\nARG TARGETARCH\nARG CLAUDE_LIBC\nHARNESS claude FROM ./claude-${TARGETARCH}-${CLAUDE_LIBC}\n\n# Its network reach, every part named (default deny): a network for this harness alone, which it joins\n# with no flow to any member; names past the microVM through its resolver (--dns); and TCP 443 out,\n# opened at the network's boundary and at the microVM's. Nothing comes in, and no other port or protocol\n# goes out. Step 9 grants its providers by name instead (f30).\nNETWORK --dns --egress=443/tcp provider FOR claude\nEXPOSE --harnesses=claude 443/tcp AS egress FOR provider\nCONNECT claude WITH claude ON provider\n\n# The project, until step 8 plugs it in at its host path (f25). And the person's own volume, given at run\n# time, as the whole HOME: a harness sees the image read-only, so only a volume makes HOME writable and\n# lasting, and Claude Code keeps everything there, ~/.claude and ~/.claude.json (f22, f33). No volume goes\n# under /tmp, which is each harness's own scratch (f23).\nVOLUME --target-kind=harness /workspace FOR claude\nVOLUME --target-kind=harness /home/claude FOR claude\n"},{"name":"harness-cursor","harness":"cursor","text":"# Cursor's CLI agent as a kiln harness in a Shards microVM (kiln plan\n# 01a1cd8e862e7169a074db3d5fa33f3d, step 27; plan 01a1ce705e5c7504b88732f443d99288, research\n# 01a1ce705e5c7504bdcac9721fa699e3). kiln runs it as its ACP server, `agent acp` (Kind \"cursor\",\n# crates/kiln/src/harness/kinds.rs). It comes in as pin.json pins it, in ./cursor-<arch>/: Cursor's\n# own Linux package, whose SHA-256 equals the .sha256 Cursor publishes beside it (Cursor signs\n# nothing; pin.sh), unpacked with its top directory stripped as Cursor's installer does, and\n# harness.json. Nothing else installs it, and no credential is in the image.\n\n# Cursor's package is a bash launcher and a bundled Node whose binaries link glibc (at most\n# GLIBC_2.28 and GLIBCXX_3.4.22, and libz), and Cursor publishes no musl build: the base needs glibc\n# and bash, and the image has no variant. This default, step 19's, pinned by digest, has both and runs\n# the package with no RUN; Alpine can't start it.\nARG BASE=buildpack-deps:trixie-scm@sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10\nFROM ${BASE}\n\n# BuildKit sets TARGETARCH in the global scope, so the stage declares it to name each platform's\n# harness directory.\nARG TARGETARCH\nHARNESS cursor FROM ./cursor-${TARGETARCH}\n\n# Its network reach, every part named (default deny): a network for this harness alone, which it\n# joins with no flow to any member; names past the microVM through its resolver (--dns); and TCP 443\n# out, opened at the network's boundary (--egress) and the microVM's (EXPOSE ... AS egress), for\n# Cursor's backend speaks HTTPS alone (HTTP/2, falling back to HTTP/1.1). These are the bring-up's\n# grants (Shards' docs/examples/harness-claude) until step 9 grants providers by name. Nothing comes\n# in; no other port or protocol goes out.\nNETWORK --dns --egress=443/tcp provider FOR cursor\nEXPOSE --harnesses=cursor 443/tcp AS egress FOR provider\nCONNECT cursor WITH cursor ON provider\n\n# The project, which moves to its own host path with step 8, and the person's home. Cursor keeps its\n# config, sessions, MCP servers, rules, plugins and hooks in $HOME/.cursor, and on Linux its sign-in\n# in $HOME/.config/cursor. A harness sees the image read-only, with its own /tmp scratch and these\n# volumes alone writable, so a home that is writable and kept from run to run must be a volume: the\n# whole home is the person's volume (step 7's shape) and harness.json sets HOME=/home/cursor.\n# Cursor's own layout lands there, and so does what the programs it runs keep in a home (.gitconfig\n# ...). HOME in run.env needs a shards at or after 997f4e47e (release v0.8.0 and later), where\n# run.env replaces init's HOME=/tmp. harness.json also puts caches that follow XDG's rule on the\n# scratch (XDG_CACHE_HOME=/tmp/.cache), out of the person's volume. Both volumes are the harness's\n# alone, and outside /tmp, which the scratch covers.\nVOLUME --target-kind=harness /workspace FOR cursor\nVOLUME --target-kind=harness /home/cursor FOR cursor\n"}]}


