#!/usr/bin/env python3
"""A stand-in for Claude Code's stream-json mode, for kiln's tests (crates/kiln/tests/wire_updates.rs).

It runs, as its own children, the commands a test puts in `.fake-claude-acts-<its pid>` in its
folder (an agent acting through its tools), writing each to `.fake-claude-acted`.

It answers kiln's control requests with success, and writes each one, a line of JSON, to
`.fake-claude-controls` in its folder when that file is there (and each user message it's sent to
`.fake-claude-messages`, likewise, with this process's pid and the message's uuid). Each user message it's sent gets a turn of
FAKE_CLAUDE_LINES assistant messages ("line 00000", "line 00001" ...; a new session's first turn
FAKE_CLAUDE_FIRST_LINES of them when that's set, not one taken up again with --resume),
FAKE_CLAUDE_EVERY_MS apart, a new session's first turn once the file FAKE_CLAUDE_GO names is there
when that's set (a test that opens many sessions says go once they're all open),
then a result, said started and completed as Claude Code says it (`command_lifecycle`, under the
user message's uuid), so kiln sends the next. As Claude Code does, it answers control requests as
they come, a turn under way or not; user messages wait their turn. Each message's id is its own (this process's, this turn's, its line's), as Claude
Code's are, so a second turn's lines are new events, not the first's again. It calls no model and
reads no account. With FAKE_CLAUDE_ACT set, each user message's text is given to that program (on
its stdin, in the session's folder) before the turn's lines, as an agent would act on it (the
conflict ladder's tests, docs/ci.md W26-R17). When that program leaves `.fake-claude-edited` in the
folder (paths in it, one a line, each file's text before in `.fake-claude-before/<path>` unless it's
new), the turn says it edited them, an Edit and its result with the file as it was, as Claude Code
says an edit, so kiln counts what changed there as the agent's (an agent's change, docs/ci.md
W26-R18); both are removed.
"""
import json
import os
import queue
import subprocess
import sys
import threading
import time
import uuid

LINES = int(os.environ.get("FAKE_CLAUDE_LINES", "100"))
# The first turn's, when it's to be longer (or shorter) than the rest.
FIRST = int(os.environ.get("FAKE_CLAUDE_FIRST_LINES", str(LINES)))
EVERY = int(os.environ.get("FAKE_CLAUDE_EVERY_MS", "50")) / 1000.0
# A file a new session's first turn waits for, when that's set.
GO = os.environ.get("FAKE_CLAUDE_GO")
VERSION = "2.1.296"


LOCK = threading.Lock()


def out(o):
    with LOCK:
        sys.stdout.write(json.dumps(o) + "\n")
        sys.stdout.flush()


def answer(m):
    """A control request, answered (and written down where a test asks for it) at once."""
    req = m.get("request") or {}
    # Each control request, one line each, where a test asks for them (it made the file).
    controls = os.path.join(os.getcwd(), ".fake-claude-controls")
    if os.path.exists(controls):
        with open(controls, "a") as f:
            f.write(json.dumps(req) + "\n")
    resp = {}
    if req.get("subtype") == "initialize":
        resp = {"commands": [], "models": [], "agents": [], "current_permission_mode": "default", "claude_code_version": VERSION}
    out({"type": "control_response", "response": {"subtype": "success", "request_id": m.get("request_id"), "response": resp}})


def record(session, rec):
    """Claude Code's own record of the session, where kiln follows it and the server resumes it from
    (`FAKE_CLAUDE_RECORD=1`: a test of resuming, CP-T3.2's sends_away)."""
    if os.environ.get("FAKE_CLAUDE_RECORD") != "1":
        return
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    d = os.path.join(base, "projects", "-fake")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, session + ".jsonl"), "a") as f:
        f.write(json.dumps(rec) + "\n")


def acts():
    """What an agent does through its tools, as this process's own children: the commands in
    `.fake-claude-acts-<its pid>` in its folder, a line each, once a test puts the file there (a copy
    of a session left behind acting on its own, W27-R08). Each is written to `.fake-claude-acted`
    with its exit code and output."""
    path = os.path.join(os.getcwd(), f".fake-claude-acts-{os.getpid()}")
    done = os.path.join(os.getcwd(), ".fake-claude-acted")
    while True:
        time.sleep(0.2)
        try:
            with open(path) as f:
                lines = [line.strip() for line in f if line.strip()]
            os.remove(path)
        except OSError:
            continue
        for line in lines:
            r = subprocess.run(line, shell=True, capture_output=True, text=True)
            with open(done, "a") as f:
                f.write(json.dumps({"cmd": line, "code": r.returncode, "out": r.stdout, "err": r.stderr, "pid": os.getpid()}) + "\n")


def main():
    threading.Thread(target=acts, daemon=True).start()
    args = sys.argv[1:]
    if "--version" in args:
        print(f"{VERSION} (Claude Code)")
        return
    session = str(uuid.uuid4())
    for flag in ("--session-id", "--resume"):
        if flag in args and args.index(flag) + 1 < len(args):
            session = args[args.index(flag) + 1]
    turn = 0
    first = LINES if "--resume" in args else FIRST
    waiting = queue.Queue()

    def read():
        for line in sys.stdin:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            kind = m.get("type")
            if kind == "control_request":
                answer(m)
            elif kind == "user":
                waiting.put(m)
        waiting.put(None)

    threading.Thread(target=read, daemon=True).start()
    while True:
        m = waiting.get()
        if m is None:
            return
        turn += 1
        record(session, {"type": "user", "uuid": m.get("uuid") or str(uuid.uuid4()), "sessionId": session, "cwd": os.getcwd(), "message": m.get("message")})
        said = os.path.join(os.getcwd(), ".fake-claude-messages")
        if os.path.exists(said):
            with open(said, "a") as f:
                f.write(json.dumps({"pid": os.getpid(), "uuid": m.get("uuid"), "message": m.get("message")}) + "\n")
        act = os.environ.get("FAKE_CLAUDE_ACT")
        if act:
            content = (m.get("message") or {}).get("content")
            text = content if isinstance(content, str) else "\n".join(b.get("text", "") for b in content or [] if isinstance(b, dict))
            import subprocess
            subprocess.run([act], input=text.encode(), cwd=os.getcwd())
        command = m.get("uuid")
        if command is not None:
            out({"type": "command_lifecycle", "command_uuid": command, "state": "started", "uuid": str(uuid.uuid4()), "session_id": session})
        out({"type": "system", "subtype": "init", "cwd": os.getcwd(), "session_id": session, "tools": [], "mcp_servers": [], "model": "claude-opus-5-5", "permissionMode": "default", "claude_code_version": VERSION})
        edited = os.path.join(os.getcwd(), ".fake-claude-edited")
        if os.path.exists(edited):
            with open(edited) as f:
                paths = [line.strip() for line in f if line.strip()]
            os.remove(edited)
            for i, rel in enumerate(paths):
                full = os.path.join(os.getcwd(), rel)
                kept = os.path.join(os.getcwd(), ".fake-claude-before", rel)
                before = None
                if os.path.exists(kept):
                    with open(kept) as f:
                        before = f.read()
                    os.remove(kept)
                tool = f"toolu_{os.getpid()}_{turn}_{i}"
                out({"type": "assistant", "message": {"id": f"msg_{os.getpid()}_{turn}_edit{i}", "type": "message", "role": "assistant", "model": "claude-opus-5-5", "content": [{"type": "tool_use", "id": tool, "name": "Edit", "input": {"file_path": full, "old_string": "", "new_string": "", "replace_all": False}}], "stop_reason": None, "usage": {"input_tokens": 1, "output_tokens": 1}}, "parent_tool_use_id": None, "session_id": session})
                out({"type": "user", "message": {"role": "user", "content": [{"tool_use_id": tool, "type": "tool_result", "content": "edited"}]}, "tool_use_result": {"filePath": full, "originalFile": before}, "parent_tool_use_id": None, "session_id": session})
        if turn == 1 and GO and "--resume" not in args:
            while not os.path.exists(GO):
                time.sleep(0.05)
        for n in range(first if turn == 1 else LINES):
            out({
                "type": "assistant",
                "message": {"id": f"msg_{os.getpid()}_{turn}_{n:05d}", "type": "message", "role": "assistant", "model": "claude-opus-5-5", "content": [{"type": "text", "text": f"line {n:05d}"}], "stop_reason": None, "usage": {"input_tokens": 1, "output_tokens": 1}},
                "parent_tool_use_id": None,
                "session_id": session,
            })
            time.sleep(EVERY)
        record(session, {"type": "assistant", "uuid": str(uuid.uuid4()), "sessionId": session, "message": {"role": "assistant", "content": [{"type": "text", "text": "done"}]}})
        out({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 1, "num_turns": 1, "result": "done", "session_id": session, "total_cost_usd": 0, "usage": {"input_tokens": 1, "output_tokens": 1}})
        if command is not None:
            out({"type": "command_lifecycle", "command_uuid": command, "state": "completed", "uuid": str(uuid.uuid4()), "session_id": session})

if __name__ == "__main__":
    main()
