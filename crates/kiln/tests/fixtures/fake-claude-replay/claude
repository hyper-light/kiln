#!/usr/bin/env python3
"""A stand-in for Claude Code's stream-json mode that replays a session written for it, for kiln's
wire budgets (crates/kiln/tests/wire_budgets.rs): text, shell commands with their output, reads,
edits and new files, as Claude Code says them. It calls no model and reads no account.

What it says comes from `.fake-replay.jsonl` in its folder: a first line `{"every_ms": n}` (the
pause after each record it writes), then one step a line, each with the `turn` it belongs to:

- `{"turn": 1, "kind": "text", "text": "..."}`: an assistant message;
- `{"turn": 1, "kind": "tool", "name": "Bash", "input": {...}, "output": "..."}`: a tool call and
  its result (Bash's as stdout; any other tool's as the result's text);
- `{"turn": 1, "kind": "tool", "name": "Edit", "path": "src/a.rs", "at": 120, "remove": 2, "insert": "..."}`:
  an edit of the file in its folder (lines `at`.. `at + remove` replaced by `insert`), made on disk,
  its result carrying the file as it was and the patch, as Claude Code's does;
- `{"turn": 1, "kind": "tool", "name": "Write", "path": "src/new.rs", "text": "..."}`: a new file.

Each user message it's sent is the next turn; its steps, then a result. Once a turn is done it
leaves `.fake-replay-turn-<n>` in its folder, so a test knows when to send the next. Control
requests are answered at once with success, as tests/fixtures/fake-claude does.
"""
import difflib
import json
import os
import queue
import sys
import threading
import time
import uuid

VERSION = "2.1.296"
LOCK = threading.Lock()


def out(o):
    with LOCK:
        sys.stdout.write(json.dumps(o) + "\n")
        sys.stdout.flush()


def answer(m):
    req = m.get("request") or {}
    resp = {}
    if req.get("subtype") == "initialize":
        resp = {"commands": [], "models": [], "agents": [], "current_permission_mode": "default", "claude_code_version": VERSION}
    out({"type": "control_response", "response": {"subtype": "success", "request_id": m.get("request_id"), "response": resp}})


def load(cwd):
    every, turns = 0.0, {}
    try:
        with open(os.path.join(cwd, ".fake-replay.jsonl")) as f:
            for n, line in enumerate(f):
                r = json.loads(line)
                if n == 0:
                    every = float(r.get("every_ms", 0)) / 1000.0
                    continue
                turns.setdefault(int(r.get("turn", 1)), []).append(r)
    except OSError:
        pass
    return every, turns


def patch(before, after):
    """Claude Code's `structuredPatch`: unified hunks, three lines of context."""
    hunks, cur = [], None
    for line in difflib.unified_diff(before.splitlines(), after.splitlines(), n=3, lineterm=""):
        if line.startswith("---") or line.startswith("+++"):
            continue
        if line.startswith("@@"):
            old, new = line.split(" ")[1:3]
            o = [int(x) for x in (old[1:].split(",") + ["1"])[:2]]
            w = [int(x) for x in (new[1:].split(",") + ["1"])[:2]]
            cur = {"oldStart": o[0], "oldLines": o[1], "newStart": w[0], "newLines": w[1], "lines": []}
            hunks.append(cur)
        elif cur is not None:
            cur["lines"].append(line)
    return hunks


def assistant(session, mid, content):
    out({"type": "assistant", "message": {"id": mid, "type": "message", "role": "assistant", "model": "claude-opus-5-5", "content": content, "stop_reason": None, "usage": {"input_tokens": 1, "output_tokens": 1}}, "parent_tool_use_id": None, "session_id": session})


def tool(session, cwd, mid, tid, r, every):
    name = r.get("name", "Bash")
    inp = dict(r.get("input") or {})
    text = r.get("output", "")
    structured = None
    act = None
    if name in ("Edit", "Write"):
        path = os.path.join(cwd, r.get("path", "file.txt"))
        before = None
        if os.path.exists(path):
            with open(path) as f:
                before = f.read()
        if name == "Edit":
            lines = (before or "").splitlines(keepends=True)
            at = int(r.get("at", 0)) % max(1, len(lines))
            old = "".join(lines[at:at + int(r.get("remove", 1))])
            new = r.get("insert", "")
            after = (before or "").replace(old, new, 1) if old else (before or "") + new
            inp = {"file_path": path, "old_string": old, "new_string": new, "replace_all": False}
            structured = {"filePath": path, "oldString": old, "newString": new, "originalFile": before, "structuredPatch": patch(before or "", after), "userModified": False, "replaceAll": False}
            text = f"The file {path} has been updated. Here's the result of running `cat -n` on a snippet of the edited file:"
        else:
            after = r.get("text", "")
            inp = {"file_path": path, "content": after}
            structured = {"type": "create", "filePath": path, "content": after, "structuredPatch": [], "originalFile": before}
            text = f"File created successfully at: {path}"

        def act():
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(after)
    elif name == "Bash":
        structured = {"stdout": text, "stderr": "", "interrupted": False, "isImage": False}
    assistant(session, mid, [{"type": "tool_use", "id": tid, "name": name, "input": inp}])
    time.sleep(every)
    if act:
        act()
    result = {"type": "user", "message": {"role": "user", "content": [{"tool_use_id": tid, "type": "tool_result", "content": text, "is_error": False}]}, "parent_tool_use_id": None, "session_id": session, "uuid": str(uuid.uuid4())}
    if structured is not None:
        result["tool_use_result"] = structured
    out(result)


def main():
    args = sys.argv[1:]
    if "--version" in args:
        print(f"{VERSION} (Claude Code)")
        return
    session = str(uuid.uuid4())
    for flag in ("--session-id", "--resume"):
        if flag in args and args.index(flag) + 1 < len(args):
            session = args[args.index(flag) + 1]
    cwd = os.getcwd()
    every, turns = load(cwd)
    waiting = queue.Queue()

    def read():
        for line in sys.stdin:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if m.get("type") == "control_request":
                answer(m)
            elif m.get("type") == "user":
                waiting.put(m)
        waiting.put(None)

    threading.Thread(target=read, daemon=True).start()
    turn, pid = 0, os.getpid()
    while True:
        m = waiting.get()
        if m is None:
            return
        turn += 1
        command = m.get("uuid")
        if command is not None:
            out({"type": "command_lifecycle", "command_uuid": command, "state": "started", "uuid": str(uuid.uuid4()), "session_id": session})
        out({"type": "system", "subtype": "init", "cwd": cwd, "session_id": session, "tools": [], "mcp_servers": [], "model": "claude-opus-5-5", "permissionMode": "default", "claude_code_version": VERSION})
        for n, r in enumerate(turns.get(turn, [])):
            mid = f"msg_{pid}_{turn}_{n:05d}"
            if r.get("kind") == "tool":
                tool(session, cwd, mid, f"toolu_{pid}_{turn}_{n:05d}", r, every)
            else:
                assistant(session, mid, [{"type": "text", "text": r.get("text", "")}])
            time.sleep(every)
        out({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 1, "num_turns": 1, "result": "done", "session_id": session, "total_cost_usd": 0, "usage": {"input_tokens": 1, "output_tokens": 1}})
        if command is not None:
            out({"type": "command_lifecycle", "command_uuid": command, "state": "completed", "uuid": str(uuid.uuid4()), "session_id": session})
        with open(os.path.join(cwd, f".fake-replay-turn-{turn}"), "w") as f:
            f.write("done\n")


if __name__ == "__main__":
    main()
