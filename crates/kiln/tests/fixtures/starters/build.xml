<project name="fixture" default="check">
  <target name="compile">
    <mkdir dir="build/classes"/>
    <javac srcdir="src/main/java" destdir="build/classes" includeantruntime="false"/>
  </target>
  <target name="jar" depends="compile">
    <jar destfile="build/fixture.jar" basedir="build/classes">
      <manifest><attribute name="Main-Class" value="fixture.Fixture"/></manifest>
    </jar>
  </target>
  <target name="check" depends="jar">
    <java jar="build/fixture.jar" fork="true" failonerror="true"/>
  </target>
</project>
