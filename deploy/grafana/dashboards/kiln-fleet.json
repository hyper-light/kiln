          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kiln_jobs_queued, job)",
          "refId": "job-var",
          "qryType": 1
        },
        "definition": "label_values(kiln_jobs_queued, job)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "hide": 0,
        "regex": "",
        "options": [],
        "skipUrlSync": false
