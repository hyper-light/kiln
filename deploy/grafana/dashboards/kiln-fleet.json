        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kiln_agent_cpu_percent{job=\"$job\"}, agent)",
          "refId": "agent-var",
          "qryType": 1
        },
        "definition": "label_values(kiln_agent_cpu_percent{job=\"$job\"}, agent)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "regex": "",
        "options": [],
        "skipUrlSync": false,
        "allValue": ".*"
      }
    ]
  },
