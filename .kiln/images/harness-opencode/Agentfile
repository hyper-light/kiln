# opencode as a harness kiln runs in a Shards microVM: OpenCode 2's own Linux build, pinned in
# pin.json by pin.sh, started by harness.json as kiln starts it (`opencode acp`). Kiln plan
# 01a1ce705e2f7773af54b299f1de42f5, on the layout steps 19 to 28 share; fN are its research's
# findings (research 01a1ce705e307593bd11f26bf9f7b9a9).
#
# `kiln agentfiles context opencode DIR --variant gnu` (or musl) writes the opencode-<arch>-<libc>
# directories HARNESS takes, each file checked against pin.json (HARNESS would take an http(s)
# source with no checksum), and prints the recipe its image is tagged with. No credential is in
# the image: a user's sign-in lives in their own volume (f19).
#
#   kiln agentfiles context opencode DIR --variant gnu
#   shards build --platform linux/amd64,linux/arm64 DIR
#   kiln agentfiles context opencode DIR --variant musl --base <a musl image>
#   shards build --platform linux/amd64,linux/arm64 --build-arg BASE=<a musl image> \
#     --build-arg OPENCODE_LIBC=musl DIR

# Any base will do, so a project's own toolchain image works. The default carries git, an ssh
# client, curl and CA certificates; opencode's glibc builds need only glibc 2.17 or later, so it
# needs nothing added (f12).
ARG BASE=buildpack-deps:trixie-scm@sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10
# gnu, or musl for a musl base such as Alpine.
ARG OPENCODE_LIBC=gnu

FROM ${BASE} AS base-gnu

# opencode's musl builds need libstdc++ (which brings libgcc), and on arm64 the distribution's
# ripgrep: the ripgrep opencode fetches for arm64 Linux is a glibc build (f13, f22, f35).
FROM ${BASE} AS base-musl
RUN apk add --no-cache libstdc++ ripgrep

FROM base-${OPENCODE_LIBC}
ARG TARGETARCH
ARG OPENCODE_LIBC

HARNESS opencode FROM ./opencode-${TARGETARCH}-${OPENCODE_LIBC}

# Its network, every part named (default deny; Shards D236, destinations by name): a network for this
# harness alone, which it joins with no flow to any member, and TCP out to the hosts below alone, by
# name, through the network's boundary (--egress) and the microVM's (EXPOSE ... AS egress). Each name
# resolves for it through the agents' resolver, and no other does. Nothing comes in; no other host,
# port or protocol goes out (kiln plan 01a1cd8e862e7169a074db3d5fa33f3d, step 18:
# docs/research/s18-host-in-vm says where each host comes from).
# - opencode takes the provider its person configures, so each provider its pinned build carries at
#   a fixed public host is granted (its provider modules' base URLs), with the sign-in hosts of those
#   it signs in to itself (ChatGPT, GitHub Copilot, GitLab); opencode.ai (OpenCode Zen and Go);
#   models.dev, its model catalog (f21); and github.com with release-assets.githubusercontent.com,
#   for the ripgrep it fetches, checked against its own SHA-256s, where its base has none (f21). Not
#   granted: a cloud platform's model service, which its own account places (Bedrock, Vertex AI,
#   Azure, Cloudflare, SAP AI Core, Snowflake); a local or self-hosted server; and npm, for providers
#   its build lacks and plugins. Each of those needs an Agentfile of your own, made from this one.
# - host.docker.internal:7070: kiln's MCP at /api/mcp on the machine itself, at kiln's own port (its
#   http_addr's default, 0.0.0.0:7070). A kiln on another port isn't reached: the image doesn't
#   grant it, and kiln says so as it starts the harness.
NETWORK --egress=ai-gateway.vercel.sh:443 --egress=api.anthropic.com:443 --egress=api.cerebras.ai:443 --egress=api.cohere.ai:443 --egress=api.deepinfra.com:443 --egress=api.deepseek.com:443 --egress=api.fireworks.ai:443 --egress=api.github.com:443 --egress=api.githubcopilot.com:443 --egress=api.groq.com:443 --egress=api.meta.ai:443 --egress=api.minimax.io:443 --egress=api.mistral.ai:443 --egress=api.moonshot.ai:443 --egress=api.openai.com:443 --egress=api.poe.com:443 --egress=api.together.xyz:443 --egress=api.typesafe.ai:443 --egress=api.venice.ai:443 --egress=api.x.ai:443 --egress=api.z.ai:443 --egress=auth.openai.com:443 --egress=chatgpt.com:443 --egress=generativelanguage.googleapis.com:443 --egress=github.com:443 --egress=gitlab.com:443 --egress=inference.baseten.co:443 --egress=inference.do-ai.run:443 --egress=models.dev:443 --egress=opencode.ai:443 --egress=openrouter.ai:443 --egress=release-assets.githubusercontent.com:443 --egress=host.docker.internal:7070 provider FOR opencode
EXPOSE --harnesses=opencode 443/tcp 7070/tcp AS egress FOR provider
CONNECT opencode WITH opencode ON provider

# Its project is plugged in as it starts, at the path it has on the machine (Shards D235), so kiln
# reads its diffs, HEAD and checkpoints at that same path, and no volume holds it. Its HOME is the
# person's volume, whole: harness.json sets HOME=/home/opencode, kiln's one rule for every harness
# it ships (step 18). A harness sees its image read-only, with its own /tmp scratch, so a HOME that
# is writable and kept from run to run is a volume, and what the programs it runs keep in a home (a
# .gitconfig, a tool's sign-in) is kept with it. opencode keeps its settings, its sessions and
# sign-in (opencode.db) and its cache in the four XDG roots beneath it (f17, f18, f19).
# HOME in run.env needs a shards at or after 997f4e47e (v0.8.0 and later), where run.env replaces
# init's HOME=/tmp. The volume is the harness's alone, and outside /tmp, which the scratch covers.
VOLUME --target-kind=harness /home/opencode FOR opencode
