# opencode as a harness kiln runs in a Shards microVM: OpenCode 2's own Linux build, pinned in
# pin.json by pin.sh, started by harness.json as kiln starts it (`opencode acp`). Kiln plan
# 01a1ce705e2f7773af54b299f1de42f5, on the layout steps 19 to 28 share; fN are its research's
# findings (research 01a1ce705e307593bd11f26bf9f7b9a9).
#
# `kiln agentfiles context opencode DIR --variant gnu` (or musl) writes the opencode-<arch>-<libc>
# directories HARNESS takes, each file checked against pin.json (HARNESS would take an http(s)
# source with no checksum), and prints the recipe its image is tagged with. No credential is in
# the image: a user's sign-in lives in their own volume (f19).
#
#   kiln agentfiles context opencode DIR --variant gnu
#   shards build --platform linux/amd64,linux/arm64 DIR
#   kiln agentfiles context opencode DIR --variant musl --base <a musl image>
#   shards build --platform linux/amd64,linux/arm64 --build-arg BASE=<a musl image> \
#     --build-arg OPENCODE_LIBC=musl DIR

# Any base will do, so a project's own toolchain image works. The default carries git, an ssh
# client, curl and CA certificates; opencode's glibc builds need only glibc 2.17 or later, so it
# needs nothing added (f12).
ARG BASE=buildpack-deps:trixie-scm@sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10
# gnu, or musl for a musl base such as Alpine.
ARG OPENCODE_LIBC=gnu

FROM ${BASE} AS base-gnu

# opencode's musl builds need libstdc++ (which brings libgcc), and on arm64 the distribution's
# ripgrep: the ripgrep opencode fetches for arm64 Linux is a glibc build (f13, f22, f35).
FROM ${BASE} AS base-musl
RUN apk add --no-cache libstdc++ ripgrep

FROM base-${OPENCODE_LIBC}
ARG TARGETARCH
ARG OPENCODE_LIBC

HARNESS opencode FROM ./opencode-${TARGETARCH}-${OPENCODE_LIBC}

