# Anthropic's Claude Code as a harness kiln ships (kiln plan 01a1cd8e862e7169a074db3d5fa33f3d, step 19;
# plan 01a1cf48e8157494ac9a51f7a564f526, research 01a1cf48e8157494b048e1fb2c437f08). Its build installs
# the binary pin.json pins: kiln writes it at ./claude-<arch>-<libc>/bin/claude, its SHA-256 checked as it
# downloads, since an http(s) HARNESS source carries no checksum (f26). No RUN fetches it, and no
# credential is in the image (f48): a person's own sign-in lives in their HOME volume.
#
# The base: buildpack-deps:trixie-scm by digest, a Docker Official Image for both arches with git, an ssh
# client, curl and CA certificates (f46). Another base works: Anthropic's glibc builds need nothing newer
# than GLIBC_2.17 (f13), and a musl base builds with CLAUDE_LIBC=musl.
ARG BASE=buildpack-deps:trixie-scm@sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10
ARG CLAUDE_LIBC=gnu

FROM ${BASE} AS base-gnu

# Anthropic's musl builds take libgcc, libstdc++ and ripgrep from the system (code.claude.com/docs/en/setup,
# "Alpine Linux and musl-based distributions"; f14).
FROM ${BASE} AS base-musl
RUN apk add --no-cache libgcc libstdc++ ripgrep

# BuildKit builds only the stage the variant names (f28).
FROM base-${CLAUDE_LIBC}
ARG TARGETARCH
ARG CLAUDE_LIBC
HARNESS claude FROM ./claude-${TARGETARCH}-${CLAUDE_LIBC}

# Its network, every part named (default deny; Shards D236, destinations by name): a network for this
# harness alone, which it joins with no flow to any member, and TCP out to the hosts below alone, by
# name, through the network's boundary (--egress) and the microVM's (EXPOSE ... AS egress). Each name
# resolves for it through the agents' resolver, and no other does. Nothing comes in; no other host,
# port or protocol goes out. 443 is HTTPS's port (RFC 9110 4.2.2). Each host is cited to its vendor's own
# documentation, or, where that names a wildcard or nothing, to the vendor's own source or build, in its
# harness's record's "Hosts by name" (kiln plan 01a1cd8e862e7169a074db3d5fa33f3d, step 18, part 4):
# docs/research/s19-claude-agentfile/README.md, from Anthropic's network docs (code.claude.com/docs/en/network-config.md,
# "Network access requirements"):
# - api.anthropic.com: Claude Code's API.
# - claude.ai: a claude.ai account's sign-in.
# - platform.claude.com: a Console account's sign-in, and a claude.ai sign-in's token exchange, refresh and revocation.
# The rest of that list is a page a sign-in opens in the person's browser, a feature kiln doesn't drive (claude.ai's
# connectors, plugins' downloads, Chrome, artifacts), an update (off: DISABLE_UPDATES) or telemetry, and goes nowhere.
# kiln's MCP isn't granted here, nor in any of kiln's Agentfiles: it reaches the harness over the link
# kiln drives it by, as that link's own `mcp` lane (Shards D254), never over the network.
NETWORK --egress=api.anthropic.com:443 --egress=claude.ai:443 --egress=platform.claude.com:443 provider FOR claude
EXPOSE --harnesses=claude 443/tcp AS egress FOR provider
CONNECT claude WITH claude ON provider

# Its project is plugged in as it starts, at the path it has on the machine (Shards D235), so kiln
# reads its diffs, HEAD and checkpoints at that same path, and no volume holds it. Its HOME is the
# person's volume, whole: harness.json sets HOME=/home/claude, kiln's one rule for every harness it
# ships (step 18). A harness sees its image read-only, with its own /tmp scratch, so a HOME that is
# writable and kept from run to run is a volume, and what the programs it runs keep in a home (a
# .gitconfig, a tool's sign-in) is kept with it. Claude Code keeps everything there, ~/.claude and
# ~/.claude.json (f22, f33).
# HOME in run.env needs a shards at or after 997f4e47e (v0.8.0 and later), where run.env replaces
# init's HOME=/tmp. The volume is the harness's alone, and outside /tmp, which the scratch covers.
VOLUME --target-kind=harness /home/claude FOR claude
