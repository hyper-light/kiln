{
  "schemaVersion": 1,
  "name": "antigravity",
  "version": "1.5.7",
  "run": {
    "command": ["agy", "--input-format", "stream-json", "--output-format", "stream-json"],
    "env": [
      "HOME=/home/antigravity",
      "AGY_CLI_DISABLE_AUTO_UPDATE=true",
      "XDG_CACHE_HOME=/tmp/.cache"
    ]
  }
}
