# Goose (aaif-goose/goose) as a harness in a Shards microVM: the Agentfile kiln ships for it (plan
# 01a1cd8e862e7169a074db3d5fa33f3d, step 23; research 01a1ce705e3d72af8563e07fa92a7460, f1-f28).
# Its build context is what `kiln agentfiles context goose DIR` writes: this file, and for each
# platform goose-<arch>/ with harness.json and pin.json's goose, checked and unpacked to bin/goose.
# It holds no credential: a person's provider keys stay on their own volume (below).

# The default base: Debian with git, an ssh client, curl and CA certificates on both arches, the
# digest pin.sh read (pin.json's base). Any base works, as Goose's build is static (f10), but Goose
# checks TLS against the base's CA bundle, so a base without one can't reach a provider (f18).
ARG BASE=buildpack-deps:trixie-scm@sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10
FROM ${BASE}

# Goose's own static build for the platform being built: no RUN, and no libc variant (f10, f23).
ARG TARGETARCH
HARNESS goose FROM ./goose-${TARGETARCH}

# Its network, every part named (default deny; Shards D236, destinations by name): a network for this
# harness alone, which it joins with no flow to any member, and TCP out to the hosts below alone, by
# name, through the network's boundary (--egress) and the microVM's (EXPOSE ... AS egress). Each name
# resolves for it through the agents' resolver, and no other does. Nothing comes in; no other host,
# port or protocol goes out (kiln plan 01a1cd8e862e7169a074db3d5fa33f3d, step 18:
# docs/research/s18-host-in-vm says where each host comes from).
# - Goose takes the provider its person configures, so each provider Goose 1.59.0 carries at a fixed
#   public host is granted (crates/goose/src/providers: its declarative definitions and its
#   providers' own constants), with the sign-in hosts of those it signs in to itself (ChatGPT,
#   Gemini's Code Assist, GitHub Copilot, Hugging Face, Kimi, Meta, xAI). Not granted: a cloud
#   platform's model service, which its own account places (Bedrock, Vertex AI, Azure, Databricks,
#   Snowflake); a local or self-hosted server (Ollama, LM Studio, LiteLLM ...); and a provider whose
#   host its person gives (an environment variable's). Each of those needs an Agentfile of your own,
#   made from this one.
# - host.docker.internal:7070: kiln's MCP at /api/mcp on the machine itself, at kiln's own port (its
#   http_addr's default, 0.0.0.0:7070). A kiln on another port isn't reached: the image doesn't
#   grant it, and kiln says so as it starts the harness.
NETWORK --egress=ai-gateway.vercel.sh:443 --egress=ai.salad.cloud:443 --egress=aihubmix.com:443 --egress=api.aigateway.sh:443 --egress=api.aimlapi.com:443 --egress=api.anthropic.com:443 --egress=api.avian.io:443 --egress=api.cerebras.ai:443 --egress=api.deepseek.com:443 --egress=api.empiriolabs.ai:443 --egress=api.eurouter.ai:443 --egress=api.fireworks.ai:443 --egress=api.friendli.ai:443 --egress=api.github.com:443 --egress=api.githubcopilot.com:443 --egress=api.gondola-ai.com:443 --egress=api.groq.com:443 --egress=api.inceptionlabs.ai:443 --egress=api.intelligence.io.solutions:443 --egress=api.kimi.com:443 --egress=api.meta.ai:443 --egress=api.minimax.io:443 --egress=api.mistral.ai:443 --egress=api.novita.ai:443 --egress=api.openai.com:443 --egress=api.opper.ai:443 --egress=api.orcarouter.ai:443 --egress=api.perplexity.ai:443 --egress=api.router.tetrate.ai:443 --egress=api.routerplex.com:443 --egress=api.sakana.ai:443 --egress=api.saygm.com:443 --egress=api.scaleway.ai:443 --egress=api.tensorix.ai:443 --egress=api.together.xyz:443 --egress=api.trustedrouter.com:443 --egress=api.typesafe.ai:443 --egress=api.venice.ai:443 --egress=api.x.ai:443 --egress=api.z.ai:443 --egress=auth.kimi.com:443 --egress=auth.meta.com:443 --egress=auth.openai.com:443 --egress=auth.x.ai:443 --egress=chatgpt.com:443 --egress=cloud-api.near.ai:443 --egress=cloudcode-pa.googleapis.com:443 --egress=dashscope-intl.aliyuncs.com:443 --egress=futurmix.ai:443 --egress=generativelanguage.googleapis.com:443 --egress=github.com:443 --egress=huggingface.co:443 --egress=inference.celeris.ai:443 --egress=integrate.api.nvidia.com:443 --egress=nano-gpt.com:443 --egress=oai.endpoints.kepler.ai.cloud.ovh.net:443 --egress=oauth2.googleapis.com:443 --egress=ollama.com:443 --egress=opencode.ai:443 --egress=openrouter.ai:443 --egress=router.huggingface.co:443 --egress=router.pleum.ai:443 --egress=spark-api-open.xf-yun.com:443 --egress=www.googleapis.com:443 --egress=host.docker.internal:7070 provider FOR goose
EXPOSE --harnesses=goose 443/tcp 7070/tcp AS egress FOR provider
CONNECT goose WITH goose ON provider

# Its project is plugged in as it starts, at the path it has on the machine (Shards D235), so kiln
# reads its diffs, HEAD and checkpoints at that same path, and no volume holds it. Its HOME is the
# person's volume, whole: harness.json sets HOME=/home/goose, kiln's one rule for every harness it
# ships (step 18). A harness sees its image read-only, with its own /tmp scratch, so a HOME that is
# writable and kept from run to run is a volume, and what the programs it runs keep in a home (a
# .gitconfig, a tool's sign-in) is kept with it. Goose keeps its config, sessions, logs and the keys
# its person saved under GOOSE_PATH_ROOT beneath it (f14, f15).
# harness.json keeps caches that follow XDG's rule on the scratch (XDG_CACHE_HOME=/tmp/.cache),
# where they were before its HOME moved onto the volume.
# HOME in run.env needs a shards at or after 997f4e47e (v0.8.0 and later), where run.env replaces
# init's HOME=/tmp. The volume is the harness's alone, and outside /tmp, which the scratch covers.
VOLUME --target-kind=harness /home/goose FOR goose
