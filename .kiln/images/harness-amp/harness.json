{
  "schemaVersion": 1,
  "name": "amp",
  "version": "0.0.1794456033-gb2ff22",
  "description": "Amp 0.0.1794456033-gb2ff22 over ACP through amp-acp 0.12.0",
  "run": {
    "command": ["amp-acp"],
    "env": [
      "HOME=/home/amp",
      "XDG_CONFIG_HOME=/home/amp/.config",
      "XDG_DATA_HOME=/home/amp/.local/share",
      "XDG_STATE_HOME=/home/amp/.local/state",
      "XDG_CACHE_HOME=/tmp/.cache",
      "AMP_SKIP_UPDATE_CHECK=1"
    ]
  }
}
