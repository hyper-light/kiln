+    /// A directory made with Ed25519 keys keeps them sealed and is read back as made by any opener,
+    /// and each of its keys signs in the same 64 bytes whatever it signs, where an ECDSA key's DER
+    /// signature varies (kiln's CP-T2.2 step 6: a simulated handshake's flight is one size in every
+    /// run of a seed).
+    #[test]
+    fn a_directory_made_as_ed25519_signs_in_one_length() {
+        use rcgen::SigningKey as _;
+        let dir = tempfile::tempdir().unwrap();
+        let made = load_or_make_with(dir.path(), None, NODES, CLIENTS, KeyKind::Ed25519).unwrap();
+        assert_sealed(dir.path(), &keys_of(&made));
+        let again = load_or_make(dir.path(), None, NODES, CLIENTS).unwrap();
+        assert_eq!(keys_of(&again), keys_of(&made));
+        for key in keys_of(&made) {
+            let key = rcgen::KeyPair::try_from(key.as_slice()).unwrap();
+            assert_eq!(key.algorithm(), &rcgen::PKCS_ED25519);
+            for message in [&b"a"[..], &[0xff; 200][..]] {
+                assert_eq!(key.sign(message).unwrap().len(), 64);
+            }
+        }
+    }
