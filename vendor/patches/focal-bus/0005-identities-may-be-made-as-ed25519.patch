+/// What a directory's identities are made with: ECDSA P-256 with SHA-256, what rcgen's
+/// `KeyPair::generate` makes and every directory before this was made with, or Ed25519. An Ed25519
+/// signature is the same 64 bytes whenever a key signs (RFC 8032 §5.1.6 draws no nonce), where an
+/// ECDSA one is a DER document whose length is as random as its nonce, 70 to 72 bytes: each
+/// handshake's certificate verify, and so its flight, may be a byte longer or shorter than the
+/// last. A simulation that replays a run from its seed makes its identities as Ed25519 (Quiver's,
+/// kiln's CP-T2.2 step 6). A directory loads alike whatever its identities were made with.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum KeyKind {
+    #[default]
+    EcdsaP256,
+    Ed25519,
+}
+
+impl KeyKind {
+    fn generate(self) -> Result<rcgen::KeyPair, rcgen::Error> {
+        match self {
+            Self::EcdsaP256 => rcgen::KeyPair::generate(),
+            Self::Ed25519 => rcgen::KeyPair::generate_for(&rcgen::PKCS_ED25519),
+        }
+    }
+}
