Subject: CP-T2.2: use MSRV-compatible atomic update name
Why: Rust 1.99 deprecates fetch_update in favor of try_update. The declared Focal MSRV 1.98.1 supports both names, verified by a tiny installed-toolchain API typecheck. Preserve every atomic type, ordering, closure and return path; no lint or runtime policy is relaxed.

diff --git a/crates/focal-memory/benches/support/alloc_count.rs b/crates/focal-memory/benches/support/alloc_count.rs
index 1c086ee97ef599a3c263c38e0ebee094b3410f9d..11f1d21e124c5b33de5cfb650d32d03a4676bea1 100644
--- a/crates/focal-memory/benches/support/alloc_count.rs
+++ b/crates/focal-memory/benches/support/alloc_count.rs
@@ -131,7 +131,7 @@ fn track_live_add(size: usize) {
 }
 
 fn track_live_sub(size: usize) {
-    let _ = LIVE.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |live| {
+    let _ = LIVE.try_update(Ordering::Relaxed, Ordering::Relaxed, |live| {
         Some(live.saturating_sub(size))
     });
 }
@@ -307,7 +307,7 @@ fn fold(rendered: &str) -> (u64, String) {
 
 fn sample(size: usize, realloc_from: Option<usize>) {
     if SAMPLE_BUDGET
-        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |left| {
+        .try_update(Ordering::Relaxed, Ordering::Relaxed, |left| {
             left.checked_sub(1)
         })
         .is_err()
