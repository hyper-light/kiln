Subject: Its crates on kiln's one hyper-raft and aws-lc-rs
Why: kiln holds one copy of each hyper-light product and of aws-lc-rs (CP-M1's one revision): Slates' crates take hyper-raft's crates by path from Slates' own vendor/, which kiln leaves out, so each path points at kiln's vendor/hyper-raft; Slates' [patch.crates-io] points aws-lc-rs at kiln's vendor/aws-lc-rs (1.18.2 with Mantle's changes) and leaves aws-lc-sys crates.io's (0.46.0)

diff --git a/Cargo.toml b/Cargo.toml
index 1f16fb030045c50212467d98c7cbdfb94379def5..a07edf6206a2bd9ac2697504671c3fd63f02b55d 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -152,11 +152,13 @@ crc32fast = "1"
 # RFC 1321 and holds it to this one and to aws-lc-rs's. No default features: it needs no `std`.
 md-5 = { version = "0.10.6", default-features = false }
 # The shared crates from ../hyper-raft, vendored at the revision in vendor/hyper-raft/SNAPSHOT (A-67).
-hyper-datagram = { path = "vendor/hyper-raft/hyper-datagram" }
-hyper-swim = { path = "vendor/hyper-raft/hyper-swim" }
-hyper-timing = { path = "vendor/hyper-raft/hyper-timing" }
+# kiln's copy: hyper-raft's crates from kiln's one copy of hyper-raft (kiln's vendor/hyper-raft), which kiln, Quiver,
+# Focal's bus and Mantle link too; Slates' own copies (its vendor/) aren't here (kiln's vendor/slates/UPSTREAM.md).
+hyper-datagram = { path = "../hyper-raft/crates/hyper-datagram" }
+hyper-swim = { path = "../hyper-raft/crates/hyper-swim" }
+hyper-timing = { path = "../hyper-raft/crates/hyper-timing" }
 # Sealing at rest (A-92; hyper-raft docs/seal.md): keys, STREAM, the ML-KEM-1024 recipient wrap, keyed names.
-hyper-seal = { path = "vendor/hyper-raft/hyper-seal" }
+hyper-seal = { path = "../hyper-raft/crates/hyper-seal" }
 # TLS 1.3 for the session plane's handshake (§4.10a §3; D-15's named dependency), over the aws-lc-rs provider. slates
 # drives the QUIC core sans-io, so rustls pulls no async runtime. rustls's config API takes Arc — D-8 exception 2.
 rustls = { version = "0.23", default-features = false, features = ["aws_lc_rs", "prefer-post-quantum", "std", "tls12"] }
@@ -242,5 +244,6 @@ panic = "abort"
 # AWS-LC and its Rust binding, built from the copies in vendor/ (vendor/UPSTREAM.md): ../mantle's vendored copies, each
 # its crates.io package plus the local changes listed there, so slates owns the exact bytes it builds.
 [patch.crates-io]
-aws-lc-rs = { path = "vendor/aws-lc-rs" }
-aws-lc-sys = { path = "vendor/aws-lc-sys" }
+# kiln's copy: aws-lc-rs at kiln's one (its release 1.18.2 with Mantle's changes, kiln's vendor/aws-lc-rs), and
+# aws-lc-sys crates.io's, as kiln builds it (kiln's vendor/slates/UPSTREAM.md).
+aws-lc-rs = { path = "../aws-lc-rs/aws-lc-rs" }
