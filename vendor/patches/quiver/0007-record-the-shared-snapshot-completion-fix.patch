+ /// A machine that keeps its owner's checkpoints images the latest, behind what it applied
+ /// (focal's): the snapshot a member behind the log's start is sent carries the configuration the
+ /// group held at the image's point, never one applied since (Ongaro and Ousterhout 2014, §7). A
+diff --git a/crates/hyper-raft/src/raft.rs b/crates/hyper-raft/src/raft.rs
+index 4baa0af2c48605001223dff83915b9254b5ee830..0d9209576adfa131d9d3d8233115a1b29aefe5e8 100644
+--- a/crates/hyper-raft/src/raft.rs
++++ b/crates/hyper-raft/src/raft.rs
+@@ -3821,13 +3821,18 @@ impl<S: Storage> Raft<S> {
+         progress.recent_active = true;
+         progress.update_committed(message.commit);
+         let paused = progress.is_paused();
+-        if !progress.maybe_update(message.index) {
++        let installed =
++            progress.state == ProgressState::Snapshot && message.index >= progress.pending_snapshot;
++        if !progress.maybe_update(message.index) && !installed {
+             return Ok(());
+         }
+         match progress.state {
+             ProgressState::Probe => progress.become_replicate(),
+             ProgressState::Snapshot => {
+-                if progress.is_snapshot_caught_up() {
++                if installed {
++                    // The receiver confirmed installation, even if the transport
++                    // never reports success. The next send follows the image.
++                    progress.pending_request_snapshot = 0;
+                     progress.become_probe();
+                 }
+             }
