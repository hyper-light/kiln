Subject: Record the shared snapshot completion fix
Why: Quiver builds on Kiln’s shared hyper-durable and must carry its pending snapshot delivery fix.

diff --git a/vendor/patches/hyper-raft/0011-send-requested-snapshots-when-compaction-becomes-durable.patch b/vendor/patches/hyper-raft/0011-send-requested-snapshots-when-compaction-becomes-durable.patch
new file mode 100644
index 0000000000000000000000000000000000000000..a3dcdb34ce10037bdafa965809ff1c908991bfef
--- /dev/null
+++ b/vendor/patches/hyper-raft/0011-send-requested-snapshots-when-compaction-becomes-durable.patch
@@ -0,0 +1,177 @@
+Subject: Send requested snapshots when compaction becomes durable
+Why: An idle session leader must serve a waiting peer as soon as its snapshot is ready and resume replication once the peer confirms installation.
+
+diff --git a/crates/hyper-durable/src/replica.rs b/crates/hyper-durable/src/replica.rs
+index 6737877fc2c9d4afb8576b03396d0a704491e966..0f48ba61a403fce5fc71db5f9888a095996b6d6d 100644
+--- a/crates/hyper-durable/src/replica.rs
++++ b/crates/hyper-durable/src/replica.rs
+@@ -1778,6 +1778,29 @@ impl<L: LogStore, M: StateMachine, B: Budget> Replica<L, M, B> {
+                 if let Some(stall) = self.stall.as_mut() {
+                     stall.freed = true;
+                 }
++                // CP-T3.2. A peer may have requested an image before one existed.
++                // A durable compaction can satisfy that request even on a quiet group.
++                if self.is_leader() {
++                    let offered = self
++                        .node
++                        .store()
++                        .snapshot
++                        .as_ref()
++                        .map_or(0, hyper_raft::proto::snapshot_index);
++                    self.waiting.clear();
++                    self.waiting
++                        .extend(self.node.raft.tracker().iter().filter_map(|(peer, p)| {
++                            (p.pending_request_snapshot != 0
++                                && p.pending_request_snapshot <= offered
++                                && p.state != ProgressState::Snapshot)
++                                .then_some(peer)
++                        }));
++                    let sent = self
++                        .waiting
++                        .iter()
++                        .try_for_each(|&peer| self.node.send_append(peer));
++                    self.must(sent)?;
++                }
+             }
+             return self.tell_durable_commit();
+         };
+diff --git a/crates/hyper-durable/tests/shell.rs b/crates/hyper-durable/tests/shell.rs
+index ab0abd82e2a7b5a56fa167ad88fdf2303582a953..12c4cd6d3929b76a1c4943add949bc18259248b6 100644
+--- a/crates/hyper-durable/tests/shell.rs
++++ b/crates/hyper-durable/tests/shell.rs
+@@ -1698,6 +1698,110 @@ fn refused(r: &mut Sim, append: &Message) -> Message {
+         .expect("a snapshot for the learner")
