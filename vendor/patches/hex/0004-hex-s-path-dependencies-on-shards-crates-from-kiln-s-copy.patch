Subject: Hex's path dependencies on Shards' crates from kiln's copy
Why: hex-runtime, hex-client and hex-node take shards-abi, shards-remote, shards-ipc, shards-afunix and shards-testdir by path from Hex's own vendor/shards; kiln's copy leaves that copy out for kiln's own (vendor/shards), and a path dependency can't be patched, so the paths name kiln's (kiln plan 01a1cd8e862e7169a074db3d5fa33f3d, step 17).
Kiln-only: kiln's layout: Hex's tree holds its copy of Shards at vendor/shards inside it

diff --git a/crates/hex-client/Cargo.toml b/crates/hex-client/Cargo.toml
index b583682759e809bcd7403db78da24e67e0a4ee6a..1869292a7e291c3e054880479a16885833b45d8b 100644
--- a/crates/hex-client/Cargo.toml
+++ b/crates/hex-client/Cargo.toml
@@ -33,21 +33,21 @@ hex-testkit.workspace = true
 tempfile.workspace = true
 # tests/shards_borrowed_contract.rs, Hex's campaign over shards-api's borrowed connector: its directories,
 # and on Windows the AF_UNIX listener and the process calls it counts handles with, as when Shards' API carried it.
-shards-testdir = { path = "../../vendor/shards/crates/testdir" }
+shards-testdir = { path = "../../../shards/crates/testdir" }
 # src/guest/lanes/tests.rs: a run's real agent-control endpoint (D251, D252) on loopback, its run host the test's.
-shards-remote = { path = "../../vendor/shards/crates/remote" }
+shards-remote = { path = "../../../shards/crates/remote" }
 # A guest's use answered with none of the protocol's (shards_abi::rate::UseBroken), which the refusal test maps as
 # Shards says it (src/guest/shards/connect_original_tests.rs); shards-api names the type without re-exporting it.
-shards-abi = { path = "../../vendor/shards/crates/abi" }
+shards-abi = { path = "../../../shards/crates/abi" }
 
 [target.'cfg(target_os = "macos")'.dev-dependencies]
 libc.workspace = true
 
 [target.'cfg(windows)'.dev-dependencies]
-shards-afunix = { path = "../../vendor/shards/crates/afunix" }
+shards-afunix = { path = "../../../shards/crates/afunix" }
 # src/guest/lanes/tests.rs on Windows: a lane's ends as Shards' run host makes them there, a plain pipe pair
 # (shards_ipc::Stream), the relay holding its VM's end.
-shards-ipc = { path = "../../vendor/shards/crates/ipc" }
+shards-ipc = { path = "../../../shards/crates/ipc" }
 windows-sys.workspace = true
 
 [lints]
