+#[path = "../../../../all-smi/src/device/readers/amd_adl/ffi.rs"]
 mod ffi;
-#[path = "../../../vendor/all-smi/src/device/readers/amd_adl/sensors.rs"]
+#[path = "../../../../all-smi/src/device/readers/amd_adl/sensors.rs"]
 mod sensors;
