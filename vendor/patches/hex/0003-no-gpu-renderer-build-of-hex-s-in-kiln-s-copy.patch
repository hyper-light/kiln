-# Hex's `shards` build (hyper-light): the `shards` binary a node boots its Shards guests and image VMs with
-# (SHARDS_BIN; crates/hex-runtime/src/guest), at the same Shards main as vendor/shards, with Hex's recorded
-# changes to it: its GPU VM process built and carried for Windows on arm64, which Shards' GPU lane holds (D232,
-# "Held"); and the run host of an image's boot holding each member to its reach of the destinations kept (D236,
-# joint plan step 15), whose API half is vendor/shards'. The run host's files (crates/shards/src/api_run.rs and
-# agentfile.rs, crates/agentfile's) are taken for its changes of joint plan steps 12 and 15. Hex compiles none of
-# it: only the files the changes touch are taken, so `check` proves each applies to this commit, and
-# scripts/shards-gpu/build.sh rebuilds `shards` from this commit plus vendor/patches/shards and
-# vendor/patches/shards-gpu, on Linux, macOS and Windows. MIT, its LICENSE taken beside it.
-[projects.shards-gpu]
-kind = "git"
-repository = "https://github.com/hyper-light/shards"
-commit = "e82b9403b863718930fe9f224186d3ae862bfd61"
-path = "vendor/shards-gpu"
-take = [
-    "LICENSE",
-    "crates/agentfile/src/agentfile.rs",
-    "crates/agentfile/tests/agentfile.rs",
-    "crates/shards/build.rs",
-    "crates/shards/src/agentfile.rs",
-    "crates/shards/src/api_run.rs",
-    "scripts/gpu-libs",
-]
-own = ["UPSTREAM.md"]
