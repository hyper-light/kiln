diff --git a/crates/hyper-rt/tests/udp.rs b/crates/hyper-rt/tests/udp.rs
index 0adcb076178255bdfd8e744c87d1d6726af07c2e..e3f1a934c2c3d0fcab8ce4c733b9c7016046d4c8 100644
