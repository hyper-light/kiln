+                return Err(Unspecified);
+            }
+            let iv: [u8; NONCE_LEN] = iv.try_into().map_err(|_| Unspecified)?;
+            let mut ctx = LcPtr::new(unsafe { EVP_CIPHER_CTX_new() })?;
+            // AWS-LC copies the key into the context.
+            if 1 != unsafe {
+                EVP_EncryptInit_ex(
+                    ctx.as_mut_ptr(),
+                    cipher,
+                    null_mut(),
+                    key_bytes.as_ptr(),
+                    null(),
+                )
+            } {
+                return Err(Unspecified);
+            }
+            Ok(Self {
+                ctx,
+                algorithm,
+                iv,
+                next_sequence: 0,
+                failed: false,
+            })
+        }
