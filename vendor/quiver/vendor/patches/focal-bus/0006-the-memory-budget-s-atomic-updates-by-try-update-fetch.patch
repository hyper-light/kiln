Subject: the memory budget's atomic updates by try_update, fetch_update's name since Rust 1.99
Why: Rust 1.99.0 deprecates the atomics' fetch_update, renamed to try_update for consistency (core::sync::atomic: try_update stable since 1.95.0, its arguments and result fetch_update's); kiln's clippy warned at each of the five, and kiln uses no deprecated API. focal's rust-version, 1.98.1, has try_update.

diff --git a/crates/focal-memory/src/budget.rs b/crates/focal-memory/src/budget.rs
index 6dfeca6c9c0c78540da27e31591240014656c976..55e99f126e9acfa5bf62b9bf5eb403a00d9cc2ec 100644
--- a/crates/focal-memory/src/budget.rs
+++ b/crates/focal-memory/src/budget.rs
@@ -232,7 +232,7 @@ impl Levels {
             Some(index) => usize::try_from(index).map_err(|_| full.clone())?,
             None => self
                 .fresh
-                .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |next| {
+                .try_update(Ordering::Relaxed, Ordering::Relaxed, |next| {
                     next.checked_add(1).filter(|next| {
                         SEGMENT
                             .checked_mul(SEGMENTS)
@@ -464,7 +464,7 @@ impl Backing {
     /// or reclassifying ancestors. Failure changes no counter.
     fn acquire(&self, bytes: usize) -> Result<(), MemoryError> {
         self.available
-            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |available| {
+            .try_update(Ordering::AcqRel, Ordering::Acquire, |available| {
                 available.checked_sub(bytes)
             })
             .map(|_| ())
@@ -1185,7 +1185,7 @@ fn child_metadata() -> usize {
 
 fn reserve_counter(counter: &AtomicUsize, limit: usize, bytes: usize) -> Result<(), MemoryError> {
     counter
-        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |used| {
+        .try_update(Ordering::AcqRel, Ordering::Acquire, |used| {
             used.checked_add(bytes).filter(|next| *next <= limit)
         })
         .map(|_| ())
diff --git a/crates/focal-memory/src/disk.rs b/crates/focal-memory/src/disk.rs
index 622367ee35708468641afc795f8d862807483a94..278dd47010e0a4c7175e75bb729d019cbbe742c6 100644
--- a/crates/focal-memory/src/disk.rs
+++ b/crates/focal-memory/src/disk.rs
@@ -278,7 +278,7 @@ impl DiskBudget {
             let _ = self
                 .0
                 .free
-                .fetch_update(Ordering::AcqRel, Ordering::Acquire, |free| {
+                .try_update(Ordering::AcqRel, Ordering::Acquire, |free| {
                     (free != UNKNOWN).then(|| free.saturating_sub(bytes))
                 });
         }
diff --git a/crates/focal-memory/src/owner.rs b/crates/focal-memory/src/owner.rs
index d0964899cde695ba33ef4f8245b4b86cfaf9cf02..99d6611d46cc9ef7e320b9117cf27f02dad02501 100644
--- a/crates/focal-memory/src/owner.rs
+++ b/crates/focal-memory/src/owner.rs
@@ -15,7 +15,7 @@ impl OwnerId {
 }
 fn next(counter: &AtomicU64) -> Result<u64, MemoryError> {
     counter
-        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+        .try_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
             value.checked_add(1)
         })
         .map_err(|_| MemoryError::CounterExhausted("owner identity"))?
